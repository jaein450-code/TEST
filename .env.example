# This file is documentation only. Export variables in your shell or hosting settings.
# Never commit real credentials.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-company-app.example
# Naver local search import (secure environment settings; never commit real values):
# NAVER_CLIENT_ID=provide-in-environment-settings
# NAVER_CLIENT_SECRET=provide-securely-in-environment-settings

# API HUB uses X-NCP-APIGW-API-KEY-ID and X-NCP-APIGW-API-KEY.
# NAVER_API_PROVIDER=apihub
# NAVER_LOCAL_SEARCH_URL=copy-the-exact-https-request-url-from-the-official-regional-search-api-reference
# Legacy developer-center keys only: NAVER_API_PROVIDER=legacy

# Render production: DATA_DIR points to an attached persistent disk.
# DATA_DIR=/var/data/matzip
# RENDER_EXTERNAL_URL is supplied by Render. PUBLIC_ORIGIN overrides it for custom domains.
